# ========================================================
# TASKIFY PRO - ENVIRONMENT CONFIGURATION
# ========================================================

# PostgreSQL Database Connection URL (e.g., Render External or Internal URL)
# Example: postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/taskify_db
DATABASE_URL=

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram Admin User IDs
ADMIN_TELEGRAM_IDS=

# Google Sheets Webhook URL (from Google Apps Script deployed as Web App)
GOOGLE_SHEET_WEBHOOK_URL=

# Platform / Service Branding Name
PLATFORM_NAME=Taskify Pro

# Default Password used for generated task credentials
DEFAULT_BOT_PASSWORD=TaskPassword@2025!

# Optional Gemini API Key for smart suggestions or validations
GEMINI_API_KEY=
